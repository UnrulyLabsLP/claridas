---
// Inline confidence token: <ConfidenceTag level="modeled" /> etc.
// Renders via the SINGLE SOURCE (src/lib/conf.mjs) so there is exactly one
// implementation of the marker HTML — shared with [slug].astro conf() and the
// remark body plugin. `verified` is the default state (no marker), so it emits
// nothing; only modeled / speculative / preprint produce a marker.
import { confMarkerHtml } from '../lib/conf.mjs';
interface Props { level: 'verified' | 'modeled' | 'speculative' | 'preprint'; source?: string; }
const { level } = Astro.props;
---
<Fragment set:html={confMarkerHtml(level)} />
