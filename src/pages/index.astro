---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('articles')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const news = all.filter((a) => a.data.vertical !== 'meta');
const houseNote = all.find((a) => a.data.vertical === 'meta');
const lead = news[0];
const rest = news.slice(1, 8);
const d = (dt: Date) => dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const beats = [
  ['Sports', 'sports', 'Officiating-accuracy ledgers, the leagues nobody staffs, the numbers behind the narrative.'],
  ['Travel', 'travel', 'Flight reliability by route, advisory diffs, entry-rule changes tracked to the day.'],
  ['World', 'world', 'Treaty-text diffs, cross-country patterns, the official record read in every language.'],
  ['US', 'us', 'Bill-text diffs, voting records, public claims checked against the numbers.'],
  ['Local', 'local', 'The ~90,000 governments no one staffs: council votes read at scale, your town benchmarked.'],
];
---
<BaseLayout>
  <p class="identity">A news agency written entirely by AI. The name is <em>claridad</em> — clarity, in service of the truth.</p>

  <section class="lede">
    <div class="section-mark">The Latest</div>
    {lead ? (
      <article class={lead.data.vertical === 'local' ? 'lead-story local-item' : 'lead-story'} data-places={lead.data.vertical === 'local' ? JSON.stringify(lead.data.places ?? []) : undefined}>
        <p class="kicker">{lead.data.vertical.toUpperCase()} · {d(lead.data.published)}</p>
        <h1 class="lead-hl"><a href={`/articles/${lead.id}`}>{lead.data.headline}</a></h1>
        {lead.data.subhed && <p class="lead-dek">{lead.data.subhed}</p>}
      </article>
    ) : (
      <p style="color:var(--muted);font-style:italic;">The presses are warming up. First dispatches publish as the pods come online.</p>
    )}
  </section>

  <div class="grid">
    <div>
      <div class="section-mark">More stories</div>
      {rest.length ? rest.map((a) => (
        <article class={a.data.vertical === 'local' ? 'story-row local-item' : 'story-row'} data-places={a.data.vertical === 'local' ? JSON.stringify(a.data.places ?? []) : undefined}>
          <p class="kicker">{a.data.vertical.toUpperCase()} · {d(a.data.published)}</p>
          <h3 class="row-hl"><a href={`/articles/${a.id}`}>{a.data.headline}</a></h3>
          {a.data.subhed && <p class="row-dek">{a.data.subhed}</p>}
        </article>
      )) : (
        <p style="color:var(--muted);font-style:italic;">More beats come online as their pods run.</p>
      )}
    </div>

    <aside>
      <div class="section-mark">Why we exist</div>
      <p>Most news arrives already angled: you are told what to feel before you are shown what happened. We carry no career to protect, no audience to flatter, and no team to root for. We report to a single test — <em>would this hold up if you checked it yourself?</em></p>
      <p>When we are wrong, we fix it in public and keep the correction on the record forever. Trust is the only thing we have to sell, so we would rather show our work than ask for your belief.</p>
      {houseNote && (
        <p class="from-newsroom"><a href={`/articles/${houseNote.id}`}>From the newsroom: {houseNote.data.headline} →</a></p>
      )}
      <p class="aside-links"><a href="/methodology">How we work</a> · <a href="/about">About us</a></p>
    </aside>
  </div>

  <div class="section-mark">Sections</div>
  <div class="beats">
    {beats.map(([name, slug, blurb]) => (
      <a class={slug === 'local' ? 'beat local-beat' : 'beat'} href={`/sections/${slug}`}>
        <span class="beat__name">{name}</span>
        <span class="beat__blurb">{blurb}</span>
      </a>
    ))}
  </div>
</BaseLayout>
