---
import { Fragment } from 'astro/jsx-runtime';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { confMarkerHtml, VERIFIED_RE, MARKER_RE } from '../../lib/conf.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;

// Long-form INVESTIGATIVE FEATURES carry a rich markdown body (headings,
// paragraphs, :::semaform callouts). Routine Semaform briefs have none — the
// body is empty. When a body exists we render <Content/> as the narrative LEAD
// above the structured record; when it's empty, layout is byte-for-byte the
// prior Semaform-only behavior (no feature-body div, no divider).
const hasBody = !!a.body?.trim();
const { Content } = await render(a);

// Confidence-tag rule (Ryan-directed 2026-08-08): VERIFIED is the DEFAULT state —
// every factual claim is sourced, so marking each one is noise that drowns the signal.
// We render a marker ONLY for departures from verified: modeled / speculative / preprint.
// [verified] tokens are stripped from display (kept in the source as an audit marker).
// Rendering goes through the SINGLE SOURCE (src/lib/conf.mjs) so there is exactly one
// implementation of the marker HTML — shared with the remark body plugin.
function conf(text: string): string {
  return text
    .replace(VERIFIED_RE, '')
    .replace(MARKER_RE, (_m, lvl) => confMarkerHtml(lvl));
}
// timeZone pinned to UTC: front-matter dates coerce to UTC-midnight, so formatting
// in any behind-UTC build machine would render the prior day. UTC keeps it deterministic.
const fmt = (dt: Date) => dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// NewsArticle structured data — only real front-matter fields. dateModified falls
// back to published when the piece has never been updated. mainEntityOfPage is the
// canonical article URL (trailing-slash form, matching the sitemap + route output).
const SITE = 'https://claridas.com';
const canonical = `${SITE}/articles/${a.id}/`;
const logo = `${SITE}/mark.svg`;
const publisher = {
  '@type': 'NewsMediaOrganization',
  name: 'Claridas News',
  logo: { '@type': 'ImageObject', url: logo },
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.headline,
  ...(d.subhed ? { description: d.subhed } : {}),
  datePublished: d.published.toISOString(),
  dateModified: (d.updated ?? d.published).toISOString(),
  author: publisher,
  publisher,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: logo,
};
---
<BaseLayout title={`${d.headline} — Claridas News`} description={d.subhed ?? d.headline} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} slot="head" />
  <article class="article prose">
    <p class="kicker">{d.vertical.toUpperCase()}</p>
    <h1>{d.headline}</h1>
    {d.subhed && <p class="subhed">{d.subhed}</p>}
    <p class="dateline">
      Filed by the Claridas {d.vertical} pod · {fmt(d.published)}
      {d.updated && <> · Updated {fmt(d.updated)}</>}
    </p>

    {d.correction && <p class="correction"><b>Correction</b> — {d.correction}</p>}
    {d.affiliateDisclosure && <p class="disclosure">{d.affiliateDisclosure}</p>}

    {hasBody && (<>
      <div class="feature-body prose"><Content /></div>
      <hr class="feature-rule" />
    </>)}

    <div class="block__label">The Facts</div>
    <div set:html={conf(d.facts)} />

    <div class="block__label">The Analysis</div>
    <div set:html={conf(d.analysis)} />

    <div class="block__label">Room for Disagreement</div>
    <div set:html={conf(d.disagreement)} />

    {d.viewFrom && (<>
      <div class="block__label">The View From</div>
      <div set:html={conf(d.viewFrom)} />
    </>)}

    <div class="block__label">Notable</div>
    <ul class="notable">
      {d.notable.map((n) => (
        <li><a href={n.url}>{n.outlet} · {n.title}</a>{n.note && <> — {n.note}</>}</li>
      ))}
    </ul>

    <div class="block__label block__label--miss">What a human would miss</div>
    <div set:html={conf(d.humanWouldMiss)} />

    <div class="methodology">
      <p><b>How this was made.</b> Models: {d.models}. Publisher of Record: {d.publisherOfRecord}. Published {fmt(d.published)}{d.updated && <> · last modified {fmt(d.updated)}</>}.</p>
      <p><b>Confidence.</b> Every factual claim here is verified against a cited primary source. A marker appears only where a claim is modeled<Fragment set:html={confMarkerHtml('modeled')} />, speculative<Fragment set:html={confMarkerHtml('speculative')} />, or preprint<Fragment set:html={confMarkerHtml('preprint')} /> — the departures from verified worth flagging.</p>
      <p><b>Sources.</b> {d.sources.map((s, i) => (<>{i > 0 && ' · '}<a href={s.url}>{s.label}</a>{s.retrieved && ` (retrieved ${s.retrieved})`}</>))}</p>
    </div>
  </article>
</BaseLayout>
